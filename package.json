{
  "name": "bytesizeict",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "bash scripts/gen-types.sh",
    "admin:create": "tsx --conditions=react-server scripts/create-admin.ts",
    "backup:db": "bash scripts/backup-db.sh",
    "restore:check": "bash scripts/restore-check.sh",
    "email:dev": "email dev --dir emails",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "check:answer-leak": "tsx scripts/check-answer-leak.ts",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm db:test && pnpm check:i18n && pnpm check:answer-leak && pnpm test:e2e && pnpm check:secrets"
  },
  "dependencies": {
    "@date-fns/tz": "1.4.1",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@node-rs/argon2": "2.0.2",
    "@react-email/components": "0.5.7",
    "@supabase/supabase-js": "2.76.1",
    "@tanstack/react-table": "8.21.3",
    "@vercel/analytics": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "exceljs": "4.4.0",
    "google-auth-library": "10.4.0",
    "katex": "0.16.25",
    "lucide-react": "0.548.0",
    "next": "16.4.5",
    "next-intl": "4.4.0",
    "next-themes": "0.4.6",
    "papaparse": "5.5.3",
    "radix-ui": "1.4.3",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "resend": "6.1.2",
    "server-only": "0.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.16",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.18.12",
    "@types/papaparse": "5.3.16",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.38.0",
    "eslint-config-next": "16.4.5",
    "jsdom": "27.0.1",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.7.1",
    "react-email": "4.3.2",
    "supabase": "2.54.11",
    "tailwindcss": "4.1.16",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "supabase",
      "unrs-resolver"
    ]
  }
}
