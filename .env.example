# Copy to .env.local for local development. Never commit real values. See docs/04_TRD.md §5.

# --- Public (inlined into the browser bundle) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Local: Supabase Auth is disabled in supabase/config.toml, so `supabase status` does not print keys.
# Use the public local-dev demo keys (signed with the default local JWT secret):
#   anon:         eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
#   service_role: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only ---
SUPABASE_SERVICE_ROLE_KEY=

# argon2id secret for PINs/passwords: base64 of >= 32 random bytes.
#   Generate: openssl rand -base64 32
# LOCAL-DEV-ONLY value used to produce the hashes in supabase/seed.sql (P1.24):
#   AUTH_PEPPER=g8wbri93vbyOmLUUcr7F5aR51bZbuzTFwPgzHfDxF6E=
# Production MUST use its own value and never load seed.sql. Rotating it invalidates every PIN.
AUTH_PEPPER=

# Optional, 32..64 (default 32)
SESSION_TOKEN_BYTES=

# Email (Resend). Empty in dev = emails are logged to the console instead of sent.
RESEND_API_KEY=
EMAIL_FROM="ByteSizeICT <no-reply@mail.example.com>"
# Receives "new admission" alerts. Empty = disabled.
ADMIN_ALERT_EMAIL=

# Google Sheets mirror. Empty GOOGLE_SHEET_ID = sync disabled.
GOOGLE_SA_EMAIL=
# PEM with literal \n escapes, wrapped in double quotes.
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Shared secret for /api/internal/outbox/drain (>= 32 chars). Generate: openssl rand -hex 32
# LOCAL-DEV-ONLY value (matches the Vault secret created in supabase/seed.sql):
#   CRON_SECRET=5bb5b4f353686f82c7c4889a272d349c897b3c3a2f72f164b07cd66db9e5cd4f
CRON_SECRET=

APP_TIMEZONE=Asia/Dhaka
